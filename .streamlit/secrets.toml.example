# Template only: never put a real key in this file (it is tracked by git).
# Locally, copy it to .streamlit/secrets.toml (git-ignored); when deployed, paste into
# Streamlit Community Cloud -> App settings -> Secrets.
# "openai" means the OpenAI-compatible API format; the base URL picks the provider.

# Google Gemini (tested: 30/30 on the agent benchmark). Key from aistudio.google.com.
LLM_PROVIDER = "openai"
OPENAI_API_KEY = "your-gemini-api-key"
OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_MODEL = "models/gemini-3.1-flash-lite"

# OpenAI:  remove OPENAI_BASE_URL, set OPENAI_MODEL = "gpt-4o-mini"
# Groq:    OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
